# 用药字段对照工作台 — 环境变量样例
# 复制本文件为 .env 后按需修改;CLI / REST 启动时按需读取。
# 路径以项目根目录(README.md 同级)为相对基准。

# 规则 markdown 目录(rx-*.md 命名)
RX_RULES_DIR=./rules

# rules_index.json 路径(单一类别清单)
RX_INDEX_PATH=./rules_index.json

# 索引产物路径(rx-index-build 的输出)
RX_DATA_DIR=./data

# audit.jsonl 路径(append-only,月度可归档)
RX_AUDIT_PATH=./audit/audit.jsonl

# FastAPI 监听地址(REST 路由绑定)
RX_API_HOST=127.0.0.1

# FastAPI 监听端口
RX_API_PORT=8765
